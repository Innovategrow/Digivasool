# DigiVasool backend configuration
# Copy this file to .env and fill in real values. Never commit .env.

# ── Security ──────────────────────────────────────────────────────────────
# Long random string used to sign login sessions. REQUIRED in production.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# How long a login stays valid (hours)
SESSION_TTL_HOURS=720
# true = OTP is shown on screen (local testing only). MUST be false in production,
# with a real SMS gateway wired into services/sms.py -> send_otp_sms().
OTP_DEV_MODE=false
# Optional extra admin keyword
ADMIN_SECRET_KEYWORD=

# ── People ────────────────────────────────────────────────────────────────
# Comma-separated "Name:+91XXXXXXXXXX" pairs
ADMIN_USERS=Owner:+910000000000
COLLECTOR_USERS=Collector 1:+910000000001,Collector 2:+910000000002
ADMIN_WHATSAPP=+910000000000

# ── Storage ───────────────────────────────────────────────────────────────
# sqlite (default) or firestore
DB_BACKEND=sqlite
DB_PATH=data/digivasool.db
# Used when DB_BACKEND=firestore (download from Firebase Console → Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Insert demo borrowers into an EMPTY database on first start (never in production)
SEED_DEMO_DATA=false
# Where payment proofs / documents are stored
UPLOAD_DIR=uploads

# ── Web ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the API (use your real domain in production)
CORS_ORIGINS=*
PORT=8000

# ── Third-party (not yet wired) ───────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_TEMPLATE_SID=
