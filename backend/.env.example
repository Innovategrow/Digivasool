# DigiVasool backend configuration
# Copy this file to .env and fill in real values. Never commit .env.

# ── Security ──────────────────────────────────────────────────────────────
# Long random string used to sign login sessions. REQUIRED in production.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# How long a login stays valid (hours)
SESSION_TTL_HOURS=168
# true = OTP is shown on screen (local testing only). MUST be false in production,
# with a real SMS gateway wired into services/sms.py -> send_otp_sms().
OTP_DEV_MODE=false
# Optional extra admin keyword
ADMIN_SECRET_KEYWORD=

# Set to production on the live server: it then refuses to start with OTP_DEV_MODE=true.
ENVIRONMENT=development

# ── People (ONE-TIME SEED of the legacy organisation ORG_001) ─────────────
# After the first start, admins/collectors live in the database and are managed from the Staff
# screen. These values are NOT used for authorisation any more.
# Comma-separated "Name:+91XXXXXXXXXX" pairs
ADMIN_USERS=Owner:+910000000000
COLLECTOR_USERS=Collector 1:+910000000001,Collector 2:+910000000002
# Which ADMIN_USERS phone becomes OWNER of ORG_001 (default: the first listed)
LEGACY_OWNER_PHONE=
ADMIN_WHATSAPP=+910000000000

# ── Storage ───────────────────────────────────────────────────────────────
# supabase (production) or sqlite (tests / throwaway local db)
DB_BACKEND=supabase
# Used when DB_BACKEND=supabase: Supabase → Project Settings → Database → Connection string (pooler URI)
DATABASE_URL=
DB_PATH=data/digivasool.db
# Insert demo borrowers into an EMPTY database on first start (never in production)
SEED_DEMO_DATA=false
# Where payment proofs / documents are stored
UPLOAD_DIR=uploads

# ── Web ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the API (use your real domain in production)
CORS_ORIGINS=*
PORT=8000

# ── Third-party (not yet wired) ───────────────────────────────────────────
# Fast2SMS OTP gateway (https://www.fast2sms.com → Dev API → API key)
FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_TEMPLATE_SID=

# ── Google Sheets live backup (optional) ──────────────────────────────────
# Sheet id from its URL, and the service-account JSON key (path or the JSON itself).
# Share the sheet with the service account's email as Editor. See services/sheets_backup.py.
GOOGLE_SHEET_ID=
# The ONE organisation mirrored into the sheet (others are never written to it)
SHEETS_BACKUP_ORG_ID=ORG_001
GOOGLE_SHEETS_CREDENTIALS=

# ── Subscriptions & payments (Razorpay) ───────────────────────────────────
# The (at most three) phone numbers allowed to create LIFETIME-FREE organisations, comma-separated, 10 digits each.
# Put the real numbers ONLY in Render's environment / your local .env - never in a committed file.
SUBSCRIPTION_EXEMPT_PHONES=
# Phones of DigiVasool operators who may open the platform dashboard (/platform). NOT the exempt numbers.
PLATFORM_ADMIN_PHONES=
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_CURRENCY=INR
# Prices in RUPEES (stored as integer paise). These defaults are PLACEHOLDERS until pricing is decided.
MONTHLY_PLAN_PRICE=499
ANNUAL_PLAN_PRICE=4999
# Razorpay Dashboard -> Account & Settings -> API keys (use rzp_test_* keys until you go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks -> your secret (events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ── Rate limiting behind a reverse proxy ──────────────────────────────────
# 0 = use the socket address. On Render set it to the number of proxies in front of the app (check one
# request's X-Forwarded-For first), otherwise every user shares one IP for the OTP limits.
TRUSTED_PROXY_HOPS=0
